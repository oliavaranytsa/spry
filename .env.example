# --- database ---
POSTGRES_USER=peach
POSTGRES_PASSWORD=peach
POSTGRES_DB=peach
POSTGRES_PORT=5432

# --- backend ---
DATABASE_URL=postgresql+asyncpg://peach:peach@db:5432/peach
BACKEND_PORT=8000
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# --- frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000

# --- aws (make deploy-backend / deploy-frontend / domain) ---
# Everything lands in us-east-1, tagged PROJECT_NAME=<PROJECT_NAME>. Every
# other knob has a default in the scripts or templates and can still be set
# here to override it.
AWS_REGION=us-east-1
PROJECT_NAME=peach
# Blank keys fall back to AWS_PROFILE, SSO, or an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=

# The deployed frontend's origin, once it has one.
API_CORS_ORIGINS=*

# --- sign-in (make deploy-cognito) ---
# https://<prefix>.auth.<region>.amazoncognito.com. Unique in the region; no
# "aws", "amazon" or "cognito" in it. Pick it before the Google OAuth client.
COGNITO_DOMAIN_PREFIX=

# An OAuth client from Google Cloud. Leave blank for email + password only;
# fill in and re-run make deploy-cognito to add Google. Its authorised
# redirect URI is printed by the deploy.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- weekly report (make deploy-reports) ---
# An address you can read: SES sends it a verification link. The report goes
# to REPORTS_RECIPIENT, or to the sender when that is empty. In the SES sandbox
# every recipient must be verified too.
REPORTS_SENDER=
REPORTS_RECIPIENT=

# --- agenda parser (Lab 6) ---
# Claude on Amazon Bedrock, always in us-east-1. Haiku is ~40x cheaper:
# PARSER_MODEL=anthropic.claude-haiku-5-5
PARSER_MODEL=anthropic.claude-opus-5-5
# The $5 monthly budget alarm (make deploy-ai). Empty: REPORTS_SENDER.
BUDGET_EMAIL=
# Origins allowed to call the parser. Empty: the CloudFront site + localhost.
AI_CORS_ORIGINS=

# --- written by the scripts, not by hand ---
# make deploy-cognito: the user pool the backend and frontend sign in against.
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_GOOGLE_ENABLED=false
# make deploy-backend: the function URL. make deploy-frontend builds against it.
BACKEND_URL=
# make domain DOMAIN=app.example.com: the frontend's custom domain.
DOMAIN_NAME=
# make deploy-reports: where reports land and where to ask for one.
REPORTS_BUCKET=
REPORTS_QUEUE_URL=
# make deploy-ai: the agenda parser's function URL. make deploy-frontend builds against it.
PARSER_URL=
