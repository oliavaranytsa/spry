# --- database ---
POSTGRES_USER=peach
POSTGRES_PASSWORD=peach
POSTGRES_DB=peach
POSTGRES_PORT=5432

# --- backend ---
DATABASE_URL=postgresql+asyncpg://peach:peach@db:5432/peach
BACKEND_PORT=8000
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# --- frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000

# --- aws (make deploy-backend / deploy-frontend / domain) ---
# Everything lands in us-east-1, tagged PROJECT_NAME=<PROJECT_NAME>. Every
# other knob has a default in the scripts or templates and can still be set
# here to override it.
AWS_REGION=us-east-1
PROJECT_NAME=peach
# Blank keys fall back to AWS_PROFILE, SSO, or an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=

# The deployed frontend's origin, once it has one.
API_CORS_ORIGINS=*

# --- sign-in, weekly report, agenda parser, budget: Terraform (Lab 7) ---
# Their settings are no longer here. They are Terraform variables: the
# non-personal ones in infra/terraform.tfvars, the personal and secret ones
# (google_client_id, google_client_secret, reports_sender, budget_email) in
# the HCP Terraform workspace spry-dev. See infra/variables.tf.

# --- agenda parser, run locally (make parse) ---
# The deployed parser's model is the Terraform variable parser_model.
PARSER_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# --- written by the scripts, not by hand ---
# make infra-env: the user pool the backend and frontend sign in against.
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_GOOGLE_ENABLED=false
# make deploy-backend: the function URL. make deploy-frontend builds against it.
BACKEND_URL=
# make domain DOMAIN=app.example.com: the frontend's custom domain.
DOMAIN_NAME=
# make infra-env: where reports land and where to ask for one.
REPORTS_BUCKET=
REPORTS_QUEUE_URL=
# make infra-env: the agenda parser's function URL. make deploy-frontend builds against it.
PARSER_URL=
